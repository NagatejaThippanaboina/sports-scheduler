<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Sports Scheduler | Plan. Play. Connect.</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="landing-page">

    <!-- =========================
         NAVIGATION
         ========================= -->

    <div class="container">

        <nav class="landing-nav">

            <a
                href="/"
                class="brand"
            >

                <div class="brand-mark">
                    S
                </div>

                <div class="brand-text">

                    <span class="brand-name">
                        Sports Scheduler
                    </span>

                    <span class="brand-subtitle">
                        Plan. Play. Connect.
                    </span>

                </div>

            </a>


            <div class="nav-actions">

                <a
                    href="/login"
                    class="btn btn-secondary btn-small"
                >
                    Login
                </a>

                <a
                    href="/signup"
                    class="btn btn-primary btn-small"
                >
                    Get Started
                </a>

            </div>

        </nav>

    </div>


    <!-- =========================
         HERO
         ========================= -->

    <main class="container">

        <section class="landing-hero">

            <div class="hero-content">

                <div class="hero-badge">
                    ⚡ Your game. Your people. Your schedule.
                </div>

                <h1 class="hero-title">
                    Plan games.
                    <br>
                    <span>Play together.</span>
                </h1>

                <p class="hero-description">
                    Sports Scheduler makes it easy to organize sports
                    sessions, find players, choose venues, and keep
                    everyone on the same page.
                </p>


                <div class="hero-actions">

                    <a
                        href="/signup"
                        class="btn btn-primary"
                    >
                        Create Your Account
                        →
                    </a>

                    <a
                        href="/login"
                        class="btn btn-secondary"
                    >
                        I Already Have an Account
                    </a>

                </div>

                <p class="hero-note">
                    Built for teams, friends, clubs, and sports communities.
                </p>

            </div>


            <!-- =========================
                 VISUAL PREVIEW
                 ========================= -->

            <div class="hero-visual">

                <div class="hero-glow"></div>

                <div class="sports-preview">

                    <div class="preview-header">

                        <h2 class="preview-title">
                            Upcoming Sessions
                        </h2>

                        <span class="preview-status">
                            Live
                        </span>

                    </div>


                    <div class="preview-session">

                        <div class="preview-session-top">

                            <div class="preview-sport-icon">
                                🏏
                            </div>

                            <div>

                                <h3 class="preview-session-name">
                                    Cricket
                                </h3>

                                <p class="preview-session-meta">
                                    Weekend Match
                                </p>

                            </div>

                        </div>

                        <div class="preview-details">
                            <span>📅 Saturday</span>
                            <span>📍 College Ground</span>
                        </div>

                    </div>


                    <div class="preview-session">

                        <div class="preview-session-top">

                            <div class="preview-sport-icon">
                                ⚽
                            </div>

                            <div>

                                <h3 class="preview-session-name">
                                    Football
                                </h3>

                                <p class="preview-session-meta">
                                    Evening Session
                                </p>

                            </div>

                        </div>

                        <div class="preview-details">
                            <span>📅 Sunday</span>
                            <span>📍 Sports Complex</span>
                        </div>

                    </div>


                    <div class="preview-session">

                        <div class="preview-session-top">

                            <div class="preview-sport-icon">
                                🏸
                            </div>

                            <div>

                                <h3 class="preview-session-name">
                                    Badminton
                                </h3>

                                <p class="preview-session-meta">
                                    Open Players
                                </p>

                            </div>

                        </div>

                        <div class="preview-details">
                            <span>👥 3 spots open</span>
                            <span>📍 Indoor Court</span>
                        </div>

                    </div>

                </div>

            </div>

        </section>

    </main>

</div>

</body>
</html>