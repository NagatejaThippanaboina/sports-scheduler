<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sports Scheduler | Plan. Play. Connect.</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <div class="landing-page">

        <!-- =========================
         NAVIGATION
         ========================= -->

        <div class="container">

            <nav class="landing-nav">

                <a href="/" class="brand">

                    <div class="brand-mark">
                        S
                    </div>

                    <div class="brand-text">

                        <span class="brand-name">
                            Sports Scheduler
                        </span>

                        <span class="brand-subtitle">
                            Plan. Play. Connect.
                        </span>

                    </div>

                </a>


                <div class="nav-actions">

                    <a href="/login" class="btn btn-secondary btn-small">
                        Login
                    </a>

                    <a href="/signup" class="btn btn-primary btn-small">
                        Get Started
                    </a>

                </div>

            </nav>

        </div>


        <!-- =========================
         HERO
         ========================= -->

        <main class="container">

            <section class="landing-hero">

                <div class="hero-content">

                    <div class="hero-badge">
                        ⚡ Your game. Your people. Your schedule.
                    </div>

                    <h1 class="hero-title">
                        Plan games.
                        <br>
                        <span>Play together.</span>
                    </h1>

                    <p class="hero-description">
                        Sports Scheduler makes it easy to organize sports
                        sessions, find players, choose venues, and keep
                        everyone on the same page.
                    </p>


                    <div class="hero-actions">

                        <a href="/signup" class="btn btn-primary">
                            Create Your Account
                            →
                        </a>

                        <a href="/login" class="btn btn-secondary">
                            I Already Have an Account
                        </a>

                    </div>

                    <p class="hero-note">
                        Built for teams, friends, clubs, and sports communities.
                    </p>

                </div>


                <!-- =========================
                 VISUAL PREVIEW
                 ========================= -->

                <div class="hero-visual">

                    <div class="hero-glow"></div>

                    <div class="sports-preview">

                        <div class="preview-header">

                            <h2 class="preview-title">
                                Upcoming Sessions
                            </h2>

                            <span class="preview-status">
                                Live Database
                            </span>

                        </div>

                        <% if (typeof upcomingSessions !=='undefined' && upcomingSessions.length> 0) { %>

                            <% upcomingSessions.forEach(session=> { %>

                                <div class="preview-session">

                                    <div class="preview-session-top">

                                        <div class="preview-sport-icon">
                                            🏆
                                        </div>

                                        <div>

                                            <h3 class="preview-session-name">
                                                <%= session.Sport ? session.Sport.name : "Sports" %>
                                            </h3>

                                            <p class="preview-session-meta">
                                                Open Match
                                            </p>

                                        </div>

                                    </div>

                                    <div class="preview-details">
                                        <span>📅 <%= new Date(session.sessionDate).toLocaleDateString('en-US', {
                                                month: 'short' , day: 'numeric' }) %></span>
                                        <span>📍 <%= session.venue %></span>
                                    </div>

                                </div>

                                <% }) %>

                                    <% } else { %>

                                        <div class="preview-session" style="text-align: center; padding: 24px 16px;">
                                            <div style="font-size: 24px; margin-bottom: 8px;">⚽ 🏏 🏸</div>
                                            <h3 class="preview-session-name" style="margin-bottom: 4px;">Ready for
                                                Action</h3>
                                            <p class="preview-session-meta" style="font-size: 12px;">Sign up or log in
                                                to create and join live game sessions in your area!</p>
                                        </div>

                                        <% } %>

                    </div>

                </div>

            </section>

        </main>

    </div>

</body>

</html>