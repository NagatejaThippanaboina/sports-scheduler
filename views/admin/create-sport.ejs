<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create Sport | Sports Scheduler</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="page">

    <!-- =========================
         NAVIGATION
         ========================= -->
    <%- include('../partials/header') %>

    <!-- =========================
         FORM
         ========================= -->

    <main class="container form-page">

        <%- include('../partials/flash-messages') %>

        <div class="form-card">

            <div class="form-header">

                <p class="eyebrow">
                    Sports Management
                </p>

                <h1>
                    Create a Sport
                </h1>

                <p>
                    Add a sport that players can use when creating
                    and joining sessions.
                </p>

            </div>


            <form
                action="/admin/sports"
                method="POST"
            >

                <div class="form-group">

                    <label
                        for="name"
                        class="form-label"
                    >
                        Sport Name
                    </label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        class="form-control"
                        placeholder="Example: Basketball"
                        required
                    >

                    <span class="form-help">
                        Use a clear name that players will recognize.
                    </span>

                </div>


                <div class="form-actions">

                    <a
                        href="/admin/dashboard"
                        class="btn btn-secondary"
                    >
                        Cancel
                    </a>

                    <div class="form-actions-right">

                        <button
                            type="submit"
                            class="btn btn-primary"
                        >
                            Create Sport
                        </button>

                    </div>

                </div>

            </form>

        </div>

    </main>

</div>

</body>
</html>