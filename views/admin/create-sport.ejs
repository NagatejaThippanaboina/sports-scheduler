<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create Sport | Sports Scheduler</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <main>

        <h1>Create a Sport</h1>

        <p>Add a sport that players can schedule.</p>

        <form action="/admin/sports" method="POST">

            <input
                type="text"
                name="name"
                placeholder="Sport name"
                required
            >

            <button type="submit">
                Create Sport
            </button>

        </form>

        <p>
            <a href="/admin/dashboard">
                ← Back to Dashboard
            </a>
        </p>

    </main>

</body>
</html>