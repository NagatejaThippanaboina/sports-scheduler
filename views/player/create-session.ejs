<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Create Session | Sports Scheduler</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="page">

    <!-- =========================
         TOP NAVIGATION
         ========================= -->
    <%- include('../partials/header') %>


    <!-- =========================
         MAIN CONTENT
         ========================= -->

    <main class="form-page">

        <div class="container">

            <!-- BACK TO DASHBOARD -->

            <a
                href="/dashboard"
                class="session-back-link"
            >
                ← Back to dashboard
            </a>

            <%- include('../partials/flash-messages') %>

            <!-- =========================
                 FORM CARD
                 ========================= -->

            <div class="form-card">

                <div class="form-header">

                    <span class="eyebrow">
                        PLAYER SESSION
                    </span>

                    <h1>
                        Create a Session
                    </h1>

                    <p>
                        Set up your game, choose the players you
                        already have, and open the remaining spots.
                    </p>

                </div>


                <form
                    action="/sessions"
                    method="POST"
                >

                    <div class="form-grid">


                        <!-- =====================
                             SPORT
                             ===================== -->

                        <div class="form-group form-group-full">

                            <label
                                for="sportId"
                                class="form-label"
                            >
                                Sport
                            </label>

                            <select
                                id="sportId"
                                name="sportId"
                                class="form-control"
                                required
                            >

                                <option value="">
                                    Select a sport
                                </option>

                                <% sports.forEach((sport) => { %>

                                    <option
                                        value="<%= sport.id %>"
                                    >
                                        <%= sport.name %>
                                    </option>

                                <% }) %>

                            </select>

                            <span class="form-help">
                                Choose the sport for this session.
                            </span>

                        </div>


                        <!-- =====================
                             DATE & TIME
                             ===================== -->

                        <div class="form-group">

                            <label
                                for="sessionDate"
                                class="form-label"
                            >
                                Date & Time
                            </label>

                            <input
                                type="datetime-local"
                                id="sessionDate"
                                name="sessionDate"
                                class="form-control"
                                required
                            >

                            <span class="form-help">
                                Choose when the game will take place.
                            </span>

                        </div>


                        <!-- =====================
                             VENUE
                             ===================== -->

                        <div class="form-group">

                            <label
                                for="venue"
                                class="form-label"
                            >
                                Venue
                            </label>

                            <input
                                type="text"
                                id="venue"
                                name="venue"
                                class="form-control"
                                placeholder="e.g. College Ground"
                                maxlength="150"
                                required
                            >

                            <span class="form-help">
                                Where will everyone meet?
                            </span>

                        </div>


                        <!-- =====================
                             TEAM 1
                             ===================== -->

                        <div class="form-group">

                            <label
                                for="teamOnePlayers"
                                class="form-label"
                            >
                                Team 1 Players
                            </label>

                            <textarea
                                id="teamOnePlayers"
                                name="teamOnePlayers"
                                class="form-control"
                                placeholder="e.g. Rahul, Teja, Kiran"
                                rows="4"
                            ></textarea>

                            <span class="form-help">
                                Add players already planned for Team 1.
                            </span>

                        </div>


                        <!-- =====================
                             TEAM 2
                             ===================== -->

                        <div class="form-group">

                            <label
                                for="teamTwoPlayers"
                                class="form-label"
                            >
                                Team 2 Players
                            </label>

                            <textarea
                                id="teamTwoPlayers"
                                name="teamTwoPlayers"
                                class="form-control"
                                placeholder="e.g. Arjun, Sai, Naveen"
                                rows="4"
                            ></textarea>

                            <span class="form-help">
                                Add players already planned for Team 2.
                            </span>

                        </div>


                        <!-- =====================
                             ADDITIONAL PLAYERS
                             ===================== -->

                        <div class="form-group">

                            <label
                                for="additionalPlayersNeeded"
                                class="form-label"
                            >
                                Additional Players Needed
                            </label>

                            <input
                                type="number"
                                id="additionalPlayersNeeded"
                                name="additionalPlayersNeeded"
                                class="form-control"
                                min="0"
                                max="100"
                                value="1"
                                required
                            >

                            <span class="form-help">
                                Number of additional players still needed.
                            </span>

                        </div>


                        <!-- =====================
                             CREATOR PARTICIPATION
                             ===================== -->

                        <div class="form-group form-group-full">

                            <label
                                class="creator-participation"
                                for="creatorParticipating"
                            >

                                <span class="creator-checkbox">

                                    <input
                                        type="checkbox"
                                        id="creatorParticipating"
                                        name="creatorParticipating"
                                        value="yes"
                                    >

                                    <span class="custom-checkbox">
                                        ✓
                                    </span>

                                </span>


                                <span class="creator-checkbox-content">

                                    <strong>
                                        I'm playing in this game
                                    </strong>

                                    <small>
                                        Add yourself to the player list
                                        automatically when the session is created.
                                    </small>

                                </span>

                            </label>

                            <span class="form-help creator-help">
                                Your participation does not reduce the
                                number of additional players needed.
                            </span>

                        </div>

                    </div>


                    <!-- =========================
                         FORM ACTIONS
                         ========================= -->

                    <div class="form-actions">

                        <span class="form-help">
                            You can view and manage your session
                            from your dashboard.
                        </span>


                        <div class="form-actions-right">

                            <a
                                href="/dashboard"
                                class="btn btn-secondary"
                            >
                                Cancel
                            </a>

                            <button
                                type="submit"
                                class="btn btn-primary"
                            >
                                Create Session
                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>

    </main>

</div>


<!-- =========================
     DATE/TIME MINIMUM
     ========================= -->

<script>
    const dateInput = document.getElementById("sessionDate");

    const now = new Date();

    const year = now.getFullYear();
    const month = String(now.getMonth() + 1).padStart(2, "0");
    const day = String(now.getDate()).padStart(2, "0");
    const hours = String(now.getHours()).padStart(2, "0");
    const minutes = String(now.getMinutes()).padStart(2, "0");

    dateInput.min =
        `${year}-${month}-${day}T${hours}:${minutes}`;
</script>

</body>
</html>