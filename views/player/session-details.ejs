<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= session.Sport.name %> Session | Sports Scheduler
    </title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <div class="page">

        <!-- TOP NAVIGATION -->
        <%- include('../partials/header') %>


            <!-- MAIN CONTENT -->
            <main class="session-page">

                <div class="container">

                    <!-- BACK LINK -->

                    <a href="/dashboard" class="session-back-link">
                        ← Back to dashboard
                    </a>

                    <%- include('../partials/flash-messages') %>


                                    <!-- SESSION HERO -->

                                    <section class="session-hero">

                                        <div class="session-hero-content">

                                            <div class="session-sport-icon">
                                                <%= session.Sport.name.charAt(0).toUpperCase() %>
                                            </div>


                                            <div>

                                                <div class="session-kicker">

                                                    <span class="session-status-dot"></span>

                                                    <% if (session.status==="cancelled" ) { %>

                                                        Cancelled session

                                                        <% } else if (session.status==="completed" ) { %>

                                                            Completed session

                                                            <% } else { %>

                                                                Scheduled session

                                                                <% } %>

                                                </div>


                                                <h1>
                                                    <%= session.Sport.name %>
                                                </h1>


                                                <p>

                                                    <% if (session.status==="cancelled" ) { %>

                                                        This session has been cancelled.

                                                        <% } else { %>

                                                            Join this game and play with other players.

                                                            <% } %>

                                                </p>

                                            </div>

                                        </div>


                                        <div class="session-hero-badge">

                                            <% if (session.status==="cancelled" ) { %>

                                                <span>—</span>

                                                <small>
                                                    cancelled
                                                </small>

                                                <% } else { %>

                                                    <span>
                                                        <%= session.additionalPlayersNeeded %>
                                                    </span>

                                                    <small>
                                                        spots left
                                                    </small>

                                                    <% } %>

                                        </div>

                                    </section>


                                    <!-- SESSION CONTENT -->

                                    <div class="session-layout">


                                        <!-- LEFT SIDE -->

                                        <section class="session-main-card">


                                            <div class="section-heading">

                                                <div>

                                                    <span class="section-eyebrow">
                                                        GAME INFORMATION
                                                    </span>

                                                    <h2>
                                                        Session details
                                                    </h2>

                                                </div>

                                            </div>


                                            <!-- SESSION INFORMATION -->

                                            <div class="session-info-grid">


                                                <!-- DATE -->

                                                <div class="session-info-box">

                                                    <div class="session-info-icon">
                                                        📅
                                                    </div>

                                                    <div>

                                                        <span>
                                                            Date & time
                                                        </span>

                                                        <strong>
                                                            <%= new Date(session.sessionDate).toLocaleString() %>
                                                        </strong>

                                                    </div>

                                                </div>


                                                <!-- VENUE -->

                                                <div class="session-info-box">

                                                    <div class="session-info-icon">
                                                        📍
                                                    </div>

                                                    <div>

                                                        <span>
                                                            Venue
                                                        </span>

                                                        <strong>
                                                            <%= session.venue %>
                                                        </strong>

                                                    </div>

                                                </div>


                                                <!-- PLAYERS NEEDED -->

                                                <div class="session-info-box">

                                                    <div class="session-info-icon">
                                                        👥
                                                    </div>

                                                    <div>

                                                        <span>
                                                            Players needed
                                                        </span>

                                                        <strong>

                                                            <%= session.additionalPlayersNeeded %>

                                                                <%= session.additionalPlayersNeeded===1 ? "player"
                                                                    : "players" %>

                                                        </strong>

                                                    </div>

                                                </div>


                                                <!-- SPORT -->

                                                <div class="session-info-box">

                                                    <div class="session-info-icon">
                                                        🏆
                                                    </div>

                                                    <div>

                                                        <span>
                                                            Sport
                                                        </span>

                                                        <strong>
                                                            <%= session.Sport.name %>
                                                        </strong>

                                                    </div>

                                                </div>


                                            </div>


                                            <!-- CANCELLATION INFORMATION -->

                                            <% if (session.status==="cancelled" ) { %>

                                                <div class="players-section">

                                                    <div class="section-heading">

                                                        <div>

                                                            <span class="section-eyebrow">
                                                                SESSION STATUS
                                                            </span>

                                                            <h2>
                                                                Session cancelled
                                                            </h2>

                                                        </div>

                                                    </div>


                                                    <div class="empty-players">

                                                        <div class="empty-players-icon">
                                                            !
                                                        </div>


                                                        <div>

                                                            <strong>
                                                                This session is no longer available.
                                                            </strong>


                                                            <% if (session.cancellationReason) { %>

                                                                <p>
                                                                    Reason:
                                                                    <%= session.cancellationReason %>
                                                                </p>

                                                                <% } %>

                                                        </div>

                                                    </div>

                                                </div>

                                                <% } %>


                                                    <!-- PLAYERS -->

                                                    <div class="players-section">


                                                        <div class="section-heading players-heading">

                                                            <div>

                                                                <span class="section-eyebrow">
                                                                    TEAM
                                                                </span>


                                                                <h2>

                                                                    Players joined

                                                                    <span class="player-count">

                                                                        <%= session.SessionParticipants ?
                                                                            session.SessionParticipants.length : 0 %>

                                                                    </span>

                                                                </h2>

                                                            </div>

                                                        </div>


                                                        <% if ( session.SessionParticipants &&
                                                            session.SessionParticipants.length> 0
                                                            ) { %>


                                                            <div class="participant-grid">


                                                                <% session.SessionParticipants.forEach( (participant,
                                                                    index)=> {
                                                                    %>


                                                                    <div class="participant-card">


                                                                        <div class="participant-avatar">

                                                                            <%= participant.User.name .charAt(0)
                                                                                .toUpperCase() %>

                                                                        </div>


                                                                        <div class="participant-info">

                                                                            <strong>
                                                                                <%= participant.User.name %>
                                                                            </strong>

                                                                            <span>
                                                                                Player <%= index + 1 %>
                                                                            </span>

                                                                        </div>


                                                                        <span class="participant-check">
                                                                            ✓
                                                                        </span>


                                                                    </div>


                                                                    <% }) %>


                                                            </div>


                                                            <% } else { %>


                                                                <div class="empty-players">


                                                                    <div class="empty-players-icon">
                                                                        👥
                                                                    </div>


                                                                    <div>

                                                                        <strong>
                                                                            No players yet
                                                                        </strong>

                                                                        <p>
                                                                            Be the first player to join
                                                                            this session.
                                                                        </p>

                                                                    </div>


                                                                </div>


                                                                <% } %>


                                                    </div>


                                        </section>


                                        <!-- RIGHT SIDEBAR -->

                                        <aside class="session-sidebar">


                                            <%
                                                const isParticipant = session.SessionParticipants && session.SessionParticipants.some(p => p.userId === user.id);
                                                const isPast = new Date(session.sessionDate) <= new Date();
                                                const isCancelled = session.status === "cancelled";
                                                const isFull = Number(session.additionalPlayersNeeded) <= 0;
                                                const canCancel = session.status === "scheduled" && !isPast && (session.createdBy === user.id || user.role === "admin");
                                            %>

                                            <!-- SESSION STATE & ACTIONS -->
                                            <% if (isCancelled) { %>
                                                <div class="join-card" style="border-color: #fecaca; background: #fffafb; text-align: center;">
                                                    <div class="join-card-top">
                                                        <span class="join-label" style="color: var(--danger, #dc2626);">STATUS</span>
                                                        <h2 style="color: #991b1b;">Session Cancelled</h2>
                                                        <p>This session is no longer taking place.</p>
                                                    </div>
                                                    <div style="margin-top: 16px;">
                                                        <span class="badge badge-cancelled" style="font-size: 14px; padding: 6px 16px;">
                                                            Cancelled
                                                        </span>
                                                    </div>
                                                </div>
                                            <% } else if (isPast) { %>
                                                <div class="join-card" style="border-color: #e2e8f0; background: #f8fafc; text-align: center;">
                                                    <div class="join-card-top">
                                                        <span class="join-label">STATUS</span>
                                                        <h2>Session Completed</h2>
                                                        <p>This game was scheduled for <%= new Date(session.sessionDate).toLocaleDateString() %>.</p>
                                                    </div>
                                                    <div style="margin-top: 16px;">
                                                        <span class="badge" style="background: #e2e8f0; color: #475569; font-size: 14px; padding: 6px 16px;">
                                                            Completed
                                                        </span>
                                                    </div>
                                                </div>
                                            <% } else if (isParticipant) { %>
                                                <div class="join-card" style="border-color: #bbf7d0; background: #f0fdf4;">
                                                    <div class="join-card-top">
                                                        <span class="join-label" style="color: #166534;">YOU'RE IN</span>
                                                        <h2 style="color: #166534;">You're Playing!</h2>
                                                        <p style="color: #15803d;">You are registered as a player in this game.</p>
                                                    </div>
                                                    <div class="spots-display" style="background: white; border-color: #bbf7d0;">
                                                        <strong style="color: #166534;">✓</strong>
                                                        <span style="color: #15803d; font-weight: 600;">You're Playing</span>
                                                    </div>
                                                    <p class="join-note" style="color: #15803d;">
                                                        See you on the field at <%= new Date(session.sessionDate).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>!
                                                    </p>
                                                </div>
                                            <% } else if (isFull) { %>
                                                <div class="join-card">
                                                    <div class="join-card-top">
                                                        <span class="join-label">SESSION FULL</span>
                                                        <h2>No Spots Left</h2>
                                                        <p>All spots for this game have been filled.</p>
                                                    </div>
                                                    <div class="spots-display">
                                                        <strong>0</strong>
                                                        <span>spots remaining</span>
                                                    </div>
                                                    <button type="button" class="join-button join-disabled" disabled style="background: #94a3b8; cursor: not-allowed;">
                                                        Full
                                                    </button>
                                                    <p class="join-note">Check back later in case a player withdraws.</p>
                                                </div>
                                            <% } else { %>
                                                <div class="join-card">
                                                    <div class="join-card-top">
                                                        <span class="join-label">READY TO PLAY?</span>
                                                        <h2>Join this session</h2>
                                                        <p>Secure your spot before all available places are filled.</p>
                                                    </div>
                                                    <div class="spots-display">
                                                        <strong><%= session.additionalPlayersNeeded %></strong>
                                                        <span><%= session.additionalPlayersNeeded === 1 ? "spot" : "spots" %> remaining</span>
                                                    </div>
                                                    <form action="/sessions/<%= session.id %>/join" method="POST">
                                                        <button type="submit" class="join-button">
                                                            Join session <span>→</span>
                                                        </button>
                                                    </form>
                                                    <p class="join-note">You can only join a session once.</p>
                                                </div>
                                            <% } %>

                                            <!-- CANCEL SESSION (CREATOR OR ADMIN) -->
                                            <% if (canCancel) { %>
                                                <div class="join-card" style="margin-top: 24px; border-color: #fecaca; background: #fffafb;">
                                                    <div class="join-card-top">
                                                        <span class="join-label" style="color: var(--danger, #dc2626);">SESSION MANAGEMENT</span>
                                                        <h2 style="color: #991b1b;">Cancel session</h2>
                                                        <p>Cancelling will make this session unavailable to all players.</p>
                                                    </div>
                                                    <form action="/sessions/<%= session.id %>/cancel" method="POST" onsubmit="return confirm('Are you sure you want to cancel this session?');">
                                                        <div style="margin-bottom: 16px;">
                                                            <label for="cancellationReason" style="display: block; margin-bottom: 8px; font-weight: 600; font-size: 13px;">
                                                                Cancellation reason
                                                            </label>
                                                            <textarea id="cancellationReason" name="cancellationReason" rows="3" required
                                                                placeholder="Enter the reason for cancelling this session..."
                                                                style="width: 100%; box-sizing: border-box; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-family: inherit; resize: vertical;"></textarea>
                                                        </div>
                                                        <button type="submit" class="btn btn-danger" style="width: 100%; min-height: 44px; font-weight: 700;">
                                                            Cancel Session
                                                        </button>
                                                    </form>
                                                </div>
                                            <% } %>


                                                            <!-- SIDEBAR NOTE -->

                                                            <div class="sidebar-note">

                                                                <span>
                                                                    💡
                                                                </span>


                                                                <div>

                                                                    <strong>
                                                                        Good to know
                                                                    </strong>


                                                                    <p>

                                                                        <% if (session.status==="cancelled" ) { %>

                                                                            This session has been cancelled.

                                                                            <% } else { %>

                                                                                Sessions cannot be joined after
                                                                                their scheduled time.

                                                                                <% } %>

                                                                    </p>

                                                                </div>

                                                            </div>


                                        </aside>


                                    </div>

                </div>

            </main>

    </div>

</body>

</html>