<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= session.Sport.name %> Session | Sports Scheduler</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="page">

    <!-- TOP NAVIGATION -->
    <header class="topbar">
        <div class="container topbar-inner">

            <a href="/dashboard" class="brand">
                <div class="brand-mark">S</div>

                <div class="brand-text">
                    <span class="brand-name">Sports Scheduler</span>
                    <span class="brand-tagline">Plan. Play. Connect.</span>
                </div>
            </a>

            <div class="topbar-actions">
                <span class="role-badge">Player</span>

                <form action="/logout" method="POST">
                    <button type="submit" class="nav-logout">
                        Logout
                    </button>
                </form>
            </div>

        </div>
    </header>


    <!-- MAIN CONTENT -->
    <main class="session-page">

        <div class="container">

            <!-- BACK LINK -->
            <a href="/dashboard" class="session-back-link">
                ← Back to dashboard
            </a>


            <!-- SESSION HERO -->
            <section class="session-hero">

                <div class="session-hero-content">

                    <div class="session-sport-icon">
                        <%= session.Sport.name.charAt(0).toUpperCase() %>
                    </div>

                    <div>

                        <div class="session-kicker">
                            <span class="session-status-dot"></span>
                            Scheduled session
                        </div>

                        <h1>
                            <%= session.Sport.name %>
                        </h1>

                        <p>
                            Join this game and play with other players.
                        </p>

                    </div>

                </div>

                <div class="session-hero-badge">
                    <span><%= session.additionalPlayersNeeded %></span>
                    <small>spots left</small>
                </div>

            </section>


            <!-- SESSION CONTENT -->
            <div class="session-layout">

                <!-- LEFT -->
                <section class="session-main-card">

                    <div class="section-heading">
                        <div>
                            <span class="section-eyebrow">GAME INFORMATION</span>
                            <h2>Session details</h2>
                        </div>
                    </div>


                    <div class="session-info-grid">

                        <div class="session-info-box">

                            <div class="session-info-icon">
                                📅
                            </div>

                            <div>
                                <span>Date & time</span>

                                <strong>
                                    <%= new Date(session.sessionDate).toLocaleString() %>
                                </strong>
                            </div>

                        </div>


                        <div class="session-info-box">

                            <div class="session-info-icon">
                                📍
                            </div>

                            <div>
                                <span>Venue</span>

                                <strong>
                                    <%= session.venue %>
                                </strong>
                            </div>

                        </div>


                        <div class="session-info-box">

                            <div class="session-info-icon">
                                👥
                            </div>

                            <div>
                                <span>Players needed</span>

                                <strong>
                                    <%= session.additionalPlayersNeeded %>
                                    <%= session.additionalPlayersNeeded === 1 ? "player" : "players" %>
                                </strong>
                            </div>

                        </div>


                        <div class="session-info-box">

                            <div class="session-info-icon">
                                🏆
                            </div>

                            <div>
                                <span>Sport</span>

                                <strong>
                                    <%= session.Sport.name %>
                                </strong>
                            </div>

                        </div>

                    </div>


                    <!-- PLAYERS -->
                    <div class="players-section">

                        <div class="section-heading players-heading">

                            <div>
                                <span class="section-eyebrow">TEAM</span>

                                <h2>
                                    Players joined
                                    <span class="player-count">
                                        <%= session.SessionParticipants ? session.SessionParticipants.length : 0 %>
                                    </span>
                                </h2>
                            </div>

                        </div>


                        <% if (session.SessionParticipants && session.SessionParticipants.length > 0) { %>

                            <div class="participant-grid">

                                <% session.SessionParticipants.forEach((participant, index) => { %>

                                    <div class="participant-card">

                                        <div class="participant-avatar">
                                            <%= participant.User.name.charAt(0).toUpperCase() %>
                                        </div>

                                        <div class="participant-info">
                                            <strong>
                                                <%= participant.User.name %>
                                            </strong>

                                            <span>
                                                Player <%= index + 1 %>
                                            </span>
                                        </div>

                                        <span class="participant-check">
                                            ✓
                                        </span>

                                    </div>

                                <% }) %>

                            </div>

                        <% } else { %>

                            <div class="empty-players">

                                <div class="empty-players-icon">
                                    👥
                                </div>

                                <div>
                                    <strong>No players yet</strong>

                                    <p>
                                        Be the first player to join this session.
                                    </p>
                                </div>

                            </div>

                        <% } %>

                    </div>

                </section>


                <!-- RIGHT SIDEBAR -->
                <aside class="session-sidebar">

                    <div class="join-card">

                        <div class="join-card-top">

                            <span class="join-label">
                                READY TO PLAY?
                            </span>

                            <h2>
                                Join this session
                            </h2>

                            <p>
                                Secure your spot before all available places are filled.
                            </p>

                        </div>


                        <div class="spots-display">

                            <strong>
                                <%= session.additionalPlayersNeeded %>
                            </strong>

                            <span>
                                <%= session.additionalPlayersNeeded === 1 ? "spot" : "spots" %> remaining
                            </span>

                        </div>


                        <% if (session.additionalPlayersNeeded > 0) { %>

                            <form
                                action="/sessions/<%= session.id %>/join"
                                method="POST"
                            >

                                <button
                                    type="submit"
                                    class="join-button"
                                >
                                    Join session
                                    <span>→</span>
                                </button>

                            </form>

                        <% } else { %>

                            <button
                                type="button"
                                class="join-button join-disabled"
                                disabled
                            >
                                Session full
                            </button>

                        <% } %>


                        <p class="join-note">
                            You can only join a session once.
                        </p>

                    </div>


                    <div class="sidebar-note">

                        <span>💡</span>

                        <div>
                            <strong>Good to know</strong>

                            <p>
                                Sessions cannot be joined after their scheduled time.
                            </p>
                        </div>

                    </div>

                </aside>

            </div>

        </div>

    </main>

</div>

</body>
</html>