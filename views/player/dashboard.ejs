<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Player Dashboard | Sports Scheduler</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="player-app">

    <!-- =====================================================
         NAVIGATION
         ===================================================== -->

    <nav class="player-nav">
        <div class="player-nav-inner">

            <a href="/dashboard" class="player-brand">
                <div class="player-brand-mark">
                    S
                </div>

                <div>
                    <strong>Sports Scheduler</strong>
                    <span>Plan. Play. Connect.</span>
                </div>
            </a>

            <div class="player-nav-right">

                <div class="player-user">

                    <div class="player-user-avatar">
                        <%= user.name.charAt(0).toUpperCase() %>
                    </div>

                    <div class="player-user-info">
                        <strong><%= user.name %></strong>
                        <span>Player</span>
                    </div>

                </div>

                <form
                    action="/logout"
                    method="POST"
                    class="logout-form"
                >
                    <button
                        type="submit"
                        class="player-logout"
                    >
                        Logout
                    </button>
                </form>

            </div>

        </div>
    </nav>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <main class="player-main">

        <div class="player-container">


            <!-- =================================================
                 FLASH MESSAGES
                 ================================================= -->

            <% if (successMessages && successMessages.length > 0) { %>

                <% successMessages.forEach(message => { %>

                    <div class="player-alert player-alert-success">

                        <div class="player-alert-icon">
                            ✓
                        </div>

                        <div>
                            <strong>Success</strong>

                            <p>
                                <%= message %>
                            </p>
                        </div>

                    </div>

                <% }) %>

            <% } %>


            <% if (errorMessages && errorMessages.length > 0) { %>

                <% errorMessages.forEach(message => { %>

                    <div class="player-alert player-alert-error">

                        <div class="player-alert-icon">
                            !
                        </div>

                        <div>
                            <strong>Something went wrong</strong>

                            <p>
                                <%= message %>
                            </p>
                        </div>

                    </div>

                <% }) %>

            <% } %>


            <!-- =================================================
                 WELCOME HEADER
                 ================================================= -->

            <section class="player-welcome">

                <div>

                    <span class="player-eyebrow">
                        PLAYER DASHBOARD
                    </span>

                    <h1>
                        Welcome back, <%= user.name %>.
                    </h1>

                    <p>
                        Find a game, join your teammates, or create
                        your own session.
                    </p>

                </div>

                <a
                    href="/sessions/new"
                    class="player-primary-action"
                >
                    <span>+</span>
                    Create Session
                </a>

            </section>


            <!-- =================================================
                 STATS
                 ================================================= -->

            <section class="player-stats">

                <div class="player-stat">

                    <div class="player-stat-label">
                        Available
                    </div>

                    <div class="player-stat-value">
                        <%= sessions.length %>
                    </div>

                    <div class="player-stat-description">
                        Upcoming sessions you can join
                    </div>

                </div>


                <div class="player-stat">

                    <div class="player-stat-label">
                        Joined
                    </div>

                    <div class="player-stat-value">
                        <%= joinedSessions.length %>
                    </div>

                    <div class="player-stat-description">
                        Sessions you've joined
                    </div>

                </div>


                <div class="player-stat">

                    <div class="player-stat-label">
                        My Sessions
                    </div>

                    <div class="player-stat-value">
                        <%= mySessions.length %>
                    </div>

                    <div class="player-stat-description">
                        Sessions created by you
                    </div>

                </div>

            </section>


            <!-- =================================================
                 AVAILABLE SESSIONS
                 ================================================= -->

            <section class="player-section">

                <div class="player-section-header">

                    <div>

                        <span class="player-section-eyebrow">
                            DISCOVER
                        </span>

                        <h2>
                            Available Sessions
                        </h2>

                        <p>
                            Find an upcoming game and join before
                            the spots fill up.
                        </p>

                    </div>

                    <span class="player-section-count">
                        <%= sessions.length %>
                        <%= sessions.length === 1 ? "session" : "sessions" %>
                    </span>

                </div>


                <% if (sessions.length === 0) { %>

                    <div class="player-empty-state">

                        <div class="player-empty-icon">
                            ○
                        </div>

                        <h3>
                            No sessions available right now
                        </h3>

                        <p>
                            Check back later or create your own
                            session and bring your team together.
                        </p>

                    </div>

                <% } else { %>

                    <div class="player-session-grid">

                        <% sessions.forEach(session => { %>

                            <article class="player-session-card">

                                <div class="session-card-top">

                                    <div class="session-sport">

                                        <div class="session-sport-mark">
                                            <%= session.Sport.name.charAt(0).toUpperCase() %>
                                        </div>

                                        <span>
                                            <%= session.Sport.name %>
                                        </span>

                                    </div>

                                    <% if (session.additionalPlayersNeeded > 0) { %>

                                        <span class="session-status">
                                            Open
                                        </span>

                                    <% } else { %>

                                        <span class="session-status">
                                            Full
                                        </span>

                                    <% } %>

                                </div>


                                <div class="session-card-body">

                                    <h3>
                                        <%= session.Sport.name %> Session
                                    </h3>


                                    <div class="session-meta">

                                        <div>

                                            <span class="session-meta-icon">
                                                📅
                                            </span>

                                            <span>
                                                <%= new Date(session.sessionDate).toLocaleDateString("en-IN", {
                                                    day: "numeric",
                                                    month: "short",
                                                    year: "numeric"
                                                }) %>
                                            </span>

                                        </div>


                                        <div>

                                            <span class="session-meta-icon">
                                                🕒
                                            </span>

                                            <span>
                                                <%= new Date(session.sessionDate).toLocaleTimeString("en-IN", {
                                                    hour: "numeric",
                                                    minute: "2-digit"
                                                }) %>
                                            </span>

                                        </div>


                                        <div>

                                            <span class="session-meta-icon">
                                                📍
                                            </span>

                                            <span>
                                                <%= session.venue %>
                                            </span>

                                        </div>

                                    </div>

                                </div>


                                <div class="session-card-footer">

                                    <div class="session-spots">

                                        <strong>
                                            <%= session.additionalPlayersNeeded %>
                                        </strong>

                                        <span>
                                            <%= session.additionalPlayersNeeded === 1
                                                ? "spot left"
                                                : "spots left"
                                            %>
                                        </span>

                                    </div>


                                    <a
                                        href="/sessions/<%= session.id %>"
                                        class="session-details-link"
                                    >
                                        View details
                                        <span>→</span>
                                    </a>

                                </div>

                            </article>

                        <% }) %>

                    </div>

                <% } %>

            </section>


            <!-- =================================================
                 JOINED SESSIONS
                 ================================================= -->

            <section class="player-section">

                <div class="player-section-header">

                    <div>

                        <span class="player-section-eyebrow">
                            YOUR SCHEDULE
                        </span>

                        <h2>
                            Joined Sessions
                        </h2>

                        <p>
                            Games you've already joined.
                        </p>

                    </div>

                    <span class="player-section-count">
                        <%= joinedSessions.length %>
                        <%= joinedSessions.length === 1 ? "session" : "sessions" %>
                    </span>

                </div>


                <% if (joinedSessions.length === 0) { %>

                    <div class="player-empty-state">

                        <div class="player-empty-icon">
                            +
                        </div>

                        <h3>
                            You haven't joined any sessions
                        </h3>

                        <p>
                            Explore available sessions above and
                            join your next game.
                        </p>

                    </div>

                <% } else { %>

                    <div class="player-session-grid">

                        <% joinedSessions.forEach(session => { %>

                            <article class="player-session-card">

                                <div class="session-card-top">

                                    <div class="session-sport">

                                        <div class="session-sport-mark">
                                            <%= session.Sport.name.charAt(0).toUpperCase() %>
                                        </div>

                                        <span>
                                            <%= session.Sport.name %>
                                        </span>

                                    </div>

                                    <span class="session-status session-status-joined">
                                        Joined
                                    </span>

                                </div>


                                <div class="session-card-body">

                                    <h3>
                                        <%= session.Sport.name %> Session
                                    </h3>


                                    <div class="session-meta">

                                        <div>

                                            <span class="session-meta-icon">
                                                📅
                                            </span>

                                            <span>
                                                <%= new Date(session.sessionDate).toLocaleDateString("en-IN", {
                                                    day: "numeric",
                                                    month: "short",
                                                    year: "numeric"
                                                }) %>
                                            </span>

                                        </div>


                                        <div>

                                            <span class="session-meta-icon">
                                                🕒
                                            </span>

                                            <span>
                                                <%= new Date(session.sessionDate).toLocaleTimeString("en-IN", {
                                                    hour: "numeric",
                                                    minute: "2-digit"
                                                }) %>
                                            </span>

                                        </div>


                                        <div>

                                            <span class="session-meta-icon">
                                                📍
                                            </span>

                                            <span>
                                                <%= session.venue %>
                                            </span>

                                        </div>

                                    </div>

                                </div>


                                <div class="session-card-footer">

                                    <span class="joined-label">
                                        You're playing
                                    </span>

                                    <a
                                        href="/sessions/<%= session.id %>"
                                        class="session-details-link"
                                    >
                                        View details
                                        <span>→</span>
                                    </a>

                                </div>

                            </article>

                        <% }) %>

                    </div>

                <% } %>

            </section>


            <!-- =================================================
                 MY SESSIONS
                 ================================================= -->

            <section class="player-section">

                <div class="player-section-header">

                    <div>

                        <span class="player-section-eyebrow">
                            CREATED BY YOU
                        </span>

                        <h2>
                            My Sessions
                        </h2>

                        <p>
                            Manage the games you've created.
                        </p>

                    </div>

                    <span class="player-section-count">
                        <%= mySessions.length %>
                        <%= mySessions.length === 1 ? "session" : "sessions" %>
                    </span>

                </div>


                <% if (mySessions.length === 0) { %>

                    <div class="player-empty-state">

                        <div class="player-empty-icon">
                            +
                        </div>

                        <h3>
                            Create your first session
                        </h3>

                        <p>
                            Set the sport, time and venue, then let
                            other players join your game.
                        </p>

                        <div style="margin-top: 18px;">

                            <a
                                href="/sessions/new"
                                class="player-primary-action"
                            >
                                <span>+</span>
                                Create Session
                            </a>

                        </div>

                    </div>

                <% } else { %>

                    <div class="player-session-grid">

                        <% mySessions.forEach(session => { %>

                            <article class="player-session-card">

                                <div class="session-card-top">

                                    <div class="session-sport">

                                        <div class="session-sport-mark">
                                            <%= session.Sport.name.charAt(0).toUpperCase() %>
                                        </div>

                                        <span>
                                            <%= session.Sport.name %>
                                        </span>

                                    </div>

                                    <% if (session.status === "cancelled") { %>

                                        <span class="session-status">
                                            Cancelled
                                        </span>

                                    <% } else if (session.additionalPlayersNeeded > 0) { %>

                                        <span class="session-status">
                                            Open
                                        </span>

                                    <% } else { %>

                                        <span class="session-status">
                                            Full
                                        </span>

                                    <% } %>

                                </div>


                                <div class="session-card-body">

                                    <h3>
                                        <%= session.Sport.name %> Session
                                    </h3>


                                    <div class="session-meta">

                                        <div>

                                            <span class="session-meta-icon">
                                                📅
                                            </span>

                                            <span>
                                                <%= new Date(session.sessionDate).toLocaleDateString("en-IN", {
                                                    day: "numeric",
                                                    month: "short",
                                                    year: "numeric"
                                                }) %>
                                            </span>

                                        </div>


                                        <div>

                                            <span class="session-meta-icon">
                                                🕒
                                            </span>

                                            <span>
                                                <%= new Date(session.sessionDate).toLocaleTimeString("en-IN", {
                                                    hour: "numeric",
                                                    minute: "2-digit"
                                                }) %>
                                            </span>

                                        </div>


                                        <div>

                                            <span class="session-meta-icon">
                                                📍
                                            </span>

                                            <span>
                                                <%= session.venue %>
                                            </span>

                                        </div>

                                    </div>

                                </div>


                                <div class="session-card-footer">

                                    <span class="created-session-label">
                                        Created by you
                                    </span>

                                    <a
                                        href="/sessions/<%= session.id %>"
                                        class="session-details-link"
                                    >
                                        View details
                                        <span>→</span>
                                    </a>

                                </div>

                            </article>

                        <% }) %>

                    </div>

                <% } %>

            </section>


        </div>

    </main>

</div>

</body>
</html>