<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Player Dashboard | Sports Scheduler</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <div class="player-app">

        <!-- =====================================================
         NAVIGATION
         ===================================================== -->

        <%- include('../partials/header') %>


            <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

            <main class="player-main">

                <div class="player-container">


                    <!-- =================================================
                 FLASH MESSAGES
                 ================================================= -->

                    <%- include('../partials/flash-messages') %>


                                                    <!-- =================================================
                 WELCOME HEADER
                 ================================================= -->

                                                    <section class="player-welcome">

                                                        <div>

                                                            <span class="player-eyebrow">
                                                                PLAYER DASHBOARD
                                                            </span>

                                                            <h1>
                                                                Welcome back, <%= user.name %>.
                                                            </h1>

                                                            <p>
                                                                Find a game, join your teammates, or create
                                                                your own session.
                                                            </p>

                                                        </div>

                                                        <a href="/sessions/new" class="player-primary-action">
                                                            <span>+</span>
                                                            Create Session
                                                        </a>

                                                    </section>


                                                    <!-- =================================================
                 STATS
                 ================================================= -->

                                                    <section class="player-stats">

                                                        <div class="player-stat">

                                                            <div class="player-stat-label">
                                                                Available
                                                            </div>

                                                            <div class="player-stat-value">
                                                                <%= sessions.length %>
                                                            </div>

                                                            <div class="player-stat-description">
                                                                Upcoming sessions you can join
                                                            </div>

                                                        </div>


                                                        <div class="player-stat">

                                                            <div class="player-stat-label">
                                                                Joined
                                                            </div>

                                                            <div class="player-stat-value">
                                                                <%= joinedSessions.length %>
                                                            </div>

                                                            <div class="player-stat-description">
                                                                Sessions you've joined
                                                            </div>

                                                        </div>


                                                        <div class="player-stat">

                                                            <div class="player-stat-label">
                                                                My Sessions
                                                            </div>

                                                            <div class="player-stat-value">
                                                                <%= mySessions.length %>
                                                            </div>

                                                            <div class="player-stat-description">
                                                                Sessions created by you
                                                            </div>

                                                        </div>

                                                    </section>


                                                    <!-- =================================================
                 AVAILABLE SESSIONS
                 ================================================= -->

                                                    <section class="player-section">

                                                        <div class="player-section-header">

                                                            <div>

                                                                <span class="player-section-eyebrow">
                                                                    DISCOVER
                                                                </span>

                                                                <h2>
                                                                    Available Sessions
                                                                </h2>

                                                                <p>
                                                                    Find an upcoming game and join before
                                                                    the spots fill up.
                                                                </p>

                                                            </div>

                                                            <span class="player-section-count">
                                                                <%= totalAvailableCount || sessions.length %>
                                                                    <%= (totalAvailableCount || sessions.length)===1
                                                                        ? "session" : "sessions" %>
                                                            </span>

                                                        </div>

                                                        <!-- FILTER PANEL -->
                                                        <div class="filter-panel"
                                                            style="margin-bottom: 20px; background: #ffffff; padding: 14px 16px; border-radius: 12px; border: 1px solid #e2e8f0;">
                                                            <form action="/dashboard" method="GET"
                                                                style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center; width: 100%;">
                                                                <div style="flex: 1; min-width: 150px;">
                                                                    <select name="sportId" class="form-control"
                                                                        style="height: 40px; font-size: 13px; padding: 0 10px;">
                                                                        <option value="">All Sports</option>
                                                                        <% if (typeof allSports !=='undefined' &&
                                                                            allSports && allSports.length> 0) { %>
                                                                            <% allSports.forEach(sport=> { %>
                                                                                <option value="<%= sport.id %>"
                                                                                    <%=typeof selectedSportId
                                                                                    !=='undefined' &&
                                                                                    String(selectedSportId)===String(sport.id)
                                                                                    ? 'selected' : '' %>><%= sport.name
                                                                                        %>
                                                                                </option>
                                                                                <% }); %>
                                                                                    <% } %>
                                                                    </select>
                                                                </div>

                                                                <div style="flex: 1; min-width: 140px;">
                                                                    <select name="status" class="form-control"
                                                                        style="height: 40px; font-size: 13px; padding: 0 10px;">
                                                                        <option value="scheduled" <%=typeof
                                                                            selectedStatus !=='undefined' &&
                                                                            selectedStatus==='scheduled' ? 'selected'
                                                                            : '' %>>Scheduled</option>
                                                                        <option value="cancelled" <%=typeof
                                                                            selectedStatus !=='undefined' &&
                                                                            selectedStatus==='cancelled' ? 'selected'
                                                                            : '' %>>Cancelled</option>
                                                                        <option value="all" <%=typeof selectedStatus
                                                                            !=='undefined' && selectedStatus==='all'
                                                                            ? 'selected' : '' %>>All Statuses</option>
                                                                    </select>
                                                                </div>

                                                                <div style="display: flex; gap: 8px;">
                                                                    <button type="submit"
                                                                        class="btn btn-primary btn-small"
                                                                        style="height: 40px;">Filter</button>
                                                                    <a href="/dashboard"
                                                                        class="btn btn-secondary btn-small"
                                                                        style="height: 40px; display: flex; align-items: center;">Reset</a>
                                                                </div>
                                                            </form>
                                                        </div>


                                                        <% if (sessions.length===0) { %>

                                                            <div class="player-empty-state">

                                                                <div class="player-empty-icon">
                                                                    🏆
                                                                </div>

                                                                <h3>
                                                                    No sessions available right now
                                                                </h3>

                                                                <p>
                                                                    Check back later or create your own session and
                                                                    bring
                                                                    your team together.
                                                                </p>

                                                            </div>

                                                            <% } else { %>

                                                                <div class="player-session-grid">

                                                                    <% sessions.forEach(session=> { %>

                                                                        <article class="player-session-card">

                                                                            <div class="session-card-top">

                                                                                <div class="session-sport">

                                                                                    <div class="session-sport-mark">
                                                                                        <%= session.Sport.name.charAt(0).toUpperCase()
                                                                                            %>
                                                                                    </div>

                                                                                    <span>
                                                                                        <%= session.Sport.name %>
                                                                                    </span>

                                                                                </div>

                                                                                <% if (session.status==="cancelled" ) {
                                                                                    %>

                                                                                    <span class="badge badge-danger">
                                                                                        Cancelled
                                                                                    </span>

                                                                                    <% } else if (new
                                                                                        Date(session.sessionDate) < new
                                                                                        Date()) { %>

                                                                                        <span
                                                                                            class="badge badge-warning"
                                                                                            style="background: #e2e8f0; color: #475569;">
                                                                                            Past
                                                                                        </span>

                                                                                        <% } else if
                                                                                            (session.additionalPlayersNeeded>
                                                                                            0) { %>

                                                                                            <span
                                                                                                class="session-status">
                                                                                                Open
                                                                                            </span>

                                                                                            <% } else { %>

                                                                                                <span
                                                                                                    class="badge badge-warning">
                                                                                                    Full
                                                                                                </span>

                                                                                                <% } %>

                                                                            </div>


                                                                            <div class="session-card-body">

                                                                                <h3>
                                                                                    <%= session.Sport.name %> Session
                                                                                </h3>

                                                                                <% if (session.status==="cancelled" &&
                                                                                    session.cancellationReason) { %>
                                                                                    <div
                                                                                        style="margin-bottom: 14px; padding: 8px 10px; background: #fef2f2; border-left: 3px solid #ef4444; border-radius: 4px; font-size: 11px; color: #991b1b;">
                                                                                        <strong>Cancelled:</strong>
                                                                                        <%= session.cancellationReason
                                                                                            %>
                                                                                    </div>
                                                                                    <% } %>


                                                                                        <div class="session-meta">

                                                                                            <div>

                                                                                                <span
                                                                                                    class="session-meta-icon">
                                                                                                    📅
                                                                                                </span>

                                                                                                <span>
                                                                                                    <%= new
                                                                                                        Date(session.sessionDate).toLocaleDateString("en-IN",
                                                                                                        { day: "numeric"
                                                                                                        , month: "short"
                                                                                                        ,
                                                                                                        year: "numeric"
                                                                                                        }) %>
                                                                                                </span>

                                                                                            </div>


                                                                                            <div>

                                                                                                <span
                                                                                                    class="session-meta-icon">
                                                                                                    🕒
                                                                                                </span>

                                                                                                <span>
                                                                                                    <%= new
                                                                                                        Date(session.sessionDate).toLocaleTimeString("en-IN",
                                                                                                        {
                                                                                                        hour: "numeric"
                                                                                                        ,
                                                                                                        minute: "2-digit"
                                                                                                        }) %>
                                                                                                </span>

                                                                                            </div>


                                                                                            <div>

                                                                                                <span
                                                                                                    class="session-meta-icon">
                                                                                                    📍
                                                                                                </span>

                                                                                                <span>
                                                                                                    <%= session.venue %>
                                                                                                </span>

                                                                                            </div>

                                                                                        </div>

                                                                            </div>


                                                                            <div class="session-card-footer">

                                                                                <div class="session-spots">

                                                                                    <strong>
                                                                                        <%= session.additionalPlayersNeeded
                                                                                            %>
                                                                                    </strong>

                                                                                    <span>
                                                                                        <%= session.additionalPlayersNeeded===1
                                                                                            ? "spot left" : "spots left"
                                                                                            %>
                                                                                    </span>

                                                                                </div>


                                                                                <a href="/sessions/<%= session.id %>"
                                                                                    class="session-details-link">
                                                                                    View details
                                                                                    <span>→</span>
                                                                                </a>

                                                                            </div>

                                                                        </article>

                                                                        <% }) %>

                                                                </div>

                                                                <% if (typeof totalPages !=='undefined' && totalPages>
                                                                    1) {
                                                                    %>
                                                                    <div class="pagination-container"
                                                                        style="display: flex; justify-content: center; align-items: center; gap: 12px; margin-top: 24px;">
                                                                        <% if (page> 1) { %>
                                                                            <a href="/dashboard?page=<%= page - 1 %>&sportId=<%= typeof selectedSportId !== 'undefined' ? selectedSportId : '' %>&status=<%= typeof selectedStatus !== 'undefined' ? selectedStatus : '' %>"
                                                                                class="btn btn-secondary btn-small">←
                                                                                Previous</a>
                                                                            <% } %>
                                                                                <span
                                                                                    style="font-size: 13px; font-weight: 600; color: var(--text-soft);">
                                                                                    Page <%= page %> of <%= totalPages
                                                                                            %>
                                                                                </span>
                                                                                <% if (page < totalPages) { %>
                                                                                    <a href="/dashboard?page=<%= page + 1 %>&sportId=<%= typeof selectedSportId !== 'undefined' ? selectedSportId : '' %>&status=<%= typeof selectedStatus !== 'undefined' ? selectedStatus : '' %>"
                                                                                        class="btn btn-secondary btn-small">Next
                                                                                        →</a>
                                                                                    <% } %>
                                                                    </div>
                                                                    <% } %>

                                                                        <% } %>

                                                    </section>


                                                    <!-- =================================================
                 JOINED SESSIONS
                 ================================================= -->

                                                    <section class="player-section">

                                                        <div class="player-section-header">

                                                            <div>

                                                                <span class="player-section-eyebrow">
                                                                    YOUR SCHEDULE
                                                                </span>

                                                                <h2>
                                                                    Joined Sessions
                                                                </h2>

                                                                <p>
                                                                    Games you've already joined.
                                                                </p>

                                                            </div>

                                                            <span class="player-section-count">
                                                                <%= joinedSessions.length %>
                                                                    <%= joinedSessions.length===1 ? "session"
                                                                        : "sessions" %>
                                                            </span>

                                                        </div>


                                                        <% if (joinedSessions.length===0) { %>

                                                            <div class="player-empty-state">

                                                                <div class="player-empty-icon">
                                                                    📅
                                                                </div>

                                                                <h3>
                                                                    You haven't joined any sessions yet
                                                                </h3>

                                                                <p>
                                                                    Explore available sessions above and join your next
                                                                    game.
                                                                </p>

                                                            </div>

                                                            <% } else { %>

                                                                <div class="player-session-grid">

                                                                    <% joinedSessions.forEach(session=> { %>

                                                                        <article class="player-session-card">

                                                                            <div class="session-card-top">

                                                                                <div class="session-sport">

                                                                                    <div class="session-sport-mark">
                                                                                        <%= session.Sport.name.charAt(0).toUpperCase()
                                                                                            %>
                                                                                    </div>

                                                                                    <span>
                                                                                        <%= session.Sport.name %>
                                                                                    </span>

                                                                                </div>

                                                                                <% if (session.status==="cancelled" ) {
                                                                                    %>

                                                                                    <span class="badge badge-danger">
                                                                                        Cancelled
                                                                                    </span>

                                                                                    <% } else if (new
                                                                                        Date(session.sessionDate) < new
                                                                                        Date()) { %>

                                                                                        <span
                                                                                            class="badge badge-warning"
                                                                                            style="background: #e2e8f0; color: #475569;">
                                                                                            Completed
                                                                                        </span>

                                                                                        <% } else { %>

                                                                                            <span
                                                                                                class="session-status session-status-joined">
                                                                                                Joined
                                                                                            </span>

                                                                                            <% } %>

                                                                            </div>


                                                                            <div class="session-card-body">

                                                                                <h3>
                                                                                    <%= session.Sport.name %> Session
                                                                                </h3>

                                                                                <% if (session.status==="cancelled" &&
                                                                                    session.cancellationReason) { %>
                                                                                    <div
                                                                                        style="margin-bottom: 14px; padding: 8px 10px; background: #fef2f2; border-left: 3px solid #ef4444; border-radius: 4px; font-size: 11px; color: #991b1b;">
                                                                                        <strong>Cancelled:</strong>
                                                                                        <%= session.cancellationReason
                                                                                            %>
                                                                                    </div>
                                                                                    <% } %>


                                                                                        <div class="session-meta">

                                                                                            <div>

                                                                                                <span
                                                                                                    class="session-meta-icon">
                                                                                                    📅
                                                                                                </span>

                                                                                                <span>
                                                                                                    <%= new
                                                                                                        Date(session.sessionDate).toLocaleDateString("en-IN",
                                                                                                        { day: "numeric"
                                                                                                        , month: "short"
                                                                                                        ,
                                                                                                        year: "numeric"
                                                                                                        }) %>
                                                                                                </span>

                                                                                            </div>


                                                                                            <div>

                                                                                                <span
                                                                                                    class="session-meta-icon">
                                                                                                    🕒
                                                                                                </span>

                                                                                                <span>
                                                                                                    <%= new
                                                                                                        Date(session.sessionDate).toLocaleTimeString("en-IN",
                                                                                                        {
                                                                                                        hour: "numeric"
                                                                                                        ,
                                                                                                        minute: "2-digit"
                                                                                                        }) %>
                                                                                                </span>

                                                                                            </div>


                                                                                            <div>

                                                                                                <span
                                                                                                    class="session-meta-icon">
                                                                                                    📍
                                                                                                </span>

                                                                                                <span>
                                                                                                    <%= session.venue %>
                                                                                                </span>

                                                                                            </div>

                                                                                        </div>

                                                                            </div>


                                                                            <div class="session-card-footer">

                                                                                <span class="joined-label">
                                                                                    You're playing
                                                                                </span>

                                                                                <a href="/sessions/<%= session.id %>"
                                                                                    class="session-details-link">
                                                                                    View details
                                                                                    <span>→</span>
                                                                                </a>

                                                                            </div>

                                                                        </article>

                                                                        <% }) %>

                                                                </div>

                                                                <% } %>

                                                    </section>


                                                    <!-- =================================================
                 MY SESSIONS
                 ================================================= -->

                                                    <section class="player-section">

                                                        <div class="player-section-header">

                                                            <div>

                                                                <span class="player-section-eyebrow">
                                                                    CREATED BY YOU
                                                                </span>

                                                                <h2>
                                                                    My Sessions
                                                                </h2>

                                                                <p>
                                                                    Manage the games you've created.
                                                                </p>

                                                            </div>

                                                            <span class="player-section-count">
                                                                <%= mySessions.length %>
                                                                    <%= mySessions.length===1 ? "session" : "sessions"
                                                                        %>
                                                            </span>

                                                        </div>


                                                        <% if (mySessions.length===0) { %>

                                                            <div class="player-empty-state">

                                                                <div class="player-empty-icon">
                                                                    +
                                                                </div>

                                                                <h3>
                                                                    Create your first session
                                                                </h3>

                                                                <p>
                                                                    Set the sport, time and venue, then let
                                                                    other players join your game.
                                                                </p>

                                                                <div style="margin-top: 18px;">

                                                                    <a href="/sessions/new"
                                                                        class="player-primary-action">
                                                                        <span>+</span>
                                                                        Create Session
                                                                    </a>

                                                                </div>

                                                            </div>

                                                            <% } else { %>

                                                                <div class="player-session-grid">

                                                                    <% mySessions.forEach(session=> { %>

                                                                        <article class="player-session-card">

                                                                            <div class="session-card-top">

                                                                                <div class="session-sport">

                                                                                    <div class="session-sport-mark">
                                                                                        <%= session.Sport.name.charAt(0).toUpperCase()
                                                                                            %>
                                                                                    </div>

                                                                                    <span>
                                                                                        <%= session.Sport.name %>
                                                                                    </span>

                                                                                </div>

                                                                                <% if (session.status==="cancelled" ) {
                                                                                    %>

                                                                                    <span class="badge badge-danger">
                                                                                        Cancelled
                                                                                    </span>

                                                                                    <% } else if (new
                                                                                        Date(session.sessionDate) < new
                                                                                        Date()) { %>

                                                                                        <span
                                                                                            class="badge badge-warning"
                                                                                            style="background: #e2e8f0; color: #475569;">
                                                                                            Completed
                                                                                        </span>

                                                                                        <% } else if
                                                                                            (session.additionalPlayersNeeded>
                                                                                            0) { %>

                                                                                            <span
                                                                                                class="session-status">
                                                                                                Open
                                                                                            </span>

                                                                                            <% } else { %>

                                                                                                <span
                                                                                                    class="badge badge-warning">
                                                                                                    Full
                                                                                                </span>

                                                                                                <% } %>

                                                                            </div>


                                                                            <div class="session-card-body">

                                                                                <h3>
                                                                                    <%= session.Sport.name %> Session
                                                                                </h3>

                                                                                <% if (session.status==="cancelled" &&
                                                                                    session.cancellationReason) { %>
                                                                                    <div
                                                                                        style="margin-bottom: 14px; padding: 8px 10px; background: #fef2f2; border-left: 3px solid #ef4444; border-radius: 4px; font-size: 11px; color: #991b1b;">
                                                                                        <strong>Cancelled:</strong>
                                                                                        <%= session.cancellationReason
                                                                                            %>
                                                                                    </div>
                                                                                    <% } %>


                                                                                        <div class="session-meta">

                                                                                            <div>

                                                                                                <span
                                                                                                    class="session-meta-icon">
                                                                                                    📅
                                                                                                </span>

                                                                                                <span>
                                                                                                    <%= new
                                                                                                        Date(session.sessionDate).toLocaleDateString("en-IN",
                                                                                                        { day: "numeric"
                                                                                                        , month: "short"
                                                                                                        ,
                                                                                                        year: "numeric"
                                                                                                        }) %>
                                                                                                </span>

                                                                                            </div>


                                                                                            <div>

                                                                                                <span
                                                                                                    class="session-meta-icon">
                                                                                                    🕒
                                                                                                </span>

                                                                                                <span>
                                                                                                    <%= new
                                                                                                        Date(session.sessionDate).toLocaleTimeString("en-IN",
                                                                                                        {
                                                                                                        hour: "numeric"
                                                                                                        ,
                                                                                                        minute: "2-digit"
                                                                                                        }) %>
                                                                                                </span>

                                                                                            </div>


                                                                                            <div>

                                                                                                <span
                                                                                                    class="session-meta-icon">
                                                                                                    📍
                                                                                                </span>

                                                                                                <span>
                                                                                                    <%= session.venue %>
                                                                                                </span>

                                                                                            </div>

                                                                                        </div>

                                                                            </div>


                                                                            <div class="session-card-footer">

                                                                                <span class="created-session-label">
                                                                                    Created by you
                                                                                </span>

                                                                                <a href="/sessions/<%= session.id %>"
                                                                                    class="session-details-link">
                                                                                    View details
                                                                                    <span>→</span>
                                                                                </a>

                                                                            </div>

                                                                        </article>

                                                                        <% }) %>

                                                                </div>

                                                                <% } %>

                                                    </section>


                </div>

            </main>

    </div>

</body>

</html>